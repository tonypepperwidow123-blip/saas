# ============================================================
# ROOT .gitignore — Protects ALL secrets across the project
# ============================================================

# Environment files — NEVER commit these
.env
.env.*
!.env.example

# Node modules — install via npm install
node_modules/
*/node_modules/

# Build outputs
dist/
build/
.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Temp / test
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
